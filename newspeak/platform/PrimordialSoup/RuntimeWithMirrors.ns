Newspeak3
'PrimordialSoup'
class RuntimeWithMirrors packageRuntimeUsing: manifest = (
	|
		private Kernel = manifest Kernel.
		public InternalKernel = manifest InternalKernel.
		private Collections = manifest Collections.
		private Mirrors = manifest Mirrors.
		private Actors = manifest Actors.
		public NewspeakASTs = manifest NewspeakASTs.
		public NewspeakPredictiveParsing = manifest NewspeakPredictiveParsing.
		public Intermediates = manifest IntermediatesForPrimordialSoup.
		public NewspeakBytecodeCompilation = manifest NewspeakBytecodeCompilation mixinApply: manifest NewspeakCompilation.
		public Newspeak2PrimordialSoupCompilation = manifest Newspeak2PrimordialSoupCompilation mixinApply: NewspeakBytecodeCompilation.
		public MetadataParsing = manifest MetadataParsing.
		private PrimordialFuel = manifest PrimordialFuel.
		private JS = manifest Aliens.
		private Host = manifest Host.
	|
) (
	public class Platform internalKernel: ik = (
		|
			public kernel = Kernel wrapping: ik.
			public collections = Collections usingInternalKernel: ik.
			public mirrors = Mirrors usingPlatform: self
				internalKernel: ik
				namespace: outer RuntimeWithMirrors.
			public victoryFuel = PrimordialFuel usingPlatform: self internalKernel: ik.
			public actors = Actors usingPlatform: self.
			public js = JS usingPlatform: self.
		|
	) (
		lazy public host = Host usingPlatform: self.
		public operatingSystem ^<String> = (
			(* :literalmessage: primitive: 99 *)
			
			halt
		)
		public supportsLiveSnapshots ^<Boolean> = (
			(* Whether this platform saves a running image and restores it into a new host. Eurasia does; this platform does not, so its Aliens never die. *)
			
			^false
		)
	) : ()
) : (
	public keepsSources ^<Boolean> = (
		^true
	)
)
