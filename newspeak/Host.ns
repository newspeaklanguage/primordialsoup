Newspeak3
'Root'
class Host usingPlatform: p = Object new (
	|
		private js = p js.
		private Resolver = p actors Resolver.
		private readyBlocks = p collections List new.
		private configKnown <Boolean> ::= false.
		private probeInFlight <Boolean> ::= false.
		private serviceBase <String> ::= ''.
		private configAlien <Alien>
	|
) (
	public class Fetcher new = Object new (
		(* An attenuated web-read capability: hand an application this object instead of platform js. It can GET a URL and nothing else. Results are Newspeak promises - fulfilled with the response body text, broken with a legible reason. *)
		
	) (
		public fetchText: url <String> ^<Promise> = (
			^fetchTextFor: url
		)
		public fetchText: url <String> headers: hdrs <Alien[JSObject] | UndefinedObject> ^<Promise> = (
			(* As fetchText:, with request headers - enough to reach an endpoint
	   behind an API key without handing the application platform js. On the
	   Croquet host this same message coordinates the fetch across clients;
	   here there is a single client, so it simply runs. *)
			
			^fetchTextFor: url headers: hdrs
		)
		public fetchBytes: url <String> ^<Promise> = (
			(* As fetchText:, but fulfilled with the response body as an ArrayBuffer.
	   For callers that want bytes rather than characters - a zip, an image -
	   and would otherwise have to be handed platform js to get them. *)
			
			^fetchBytesFor: url
		)
		public fetchBytes: url <String> headers: hdrs <Alien[JSObject] | UndefinedObject> ^<Promise> = (
			(* As fetchBytes:, with request headers. *)
			
			^fetchBytesFor: url headers: hdrs
		)
		public fetchText: url <String> headers: hdrs <Alien[JSObject] | UndefinedObject> body: body <String | UndefinedObject> ^<Promise> = (
			(* POST body to url and answer the response text. The capability is no
	   longer read-only once this exists, which is deliberate and narrow: a
	   model completion is a POST, and routing it through here is what lets
	   the Croquet host make it happen ONCE for a session rather than once
	   per client. Everything else about the shape is as fetchText:headers:.

	   body is already-serialised text (the caller stringifies its own JSON);
	   this capability does not know what is in it. *)
			
			^fetchTextFor: url headers: hdrs body: body
		)
	) : ()
	public class Performer new = Object new (
		(* Runs one request/reply exchange that the caller carries out itself, and
	 answers a Newspeak promise of the reply text.

	 It exists for transports that are not a fetch. The agent bus is the case
	 in hand: its reply does not come back from the request at all, but later
	 on a shared event stream, correlated by id - so there is no URL to name it
	 by and nothing for the Fetcher seam to hold on to.

	 The caller supplies the request TEXT, which is what identifies the
	 exchange, and a block that performs it. Here that block simply runs. On
	 the Croquet host the same call runs it on the elected client only and
	 records the reply, so a bus completion - billed, and not idempotent -
	 happens once for the session rather than once per client. As with the
	 Fetcher, the caller never names a coordination key: it hands over the
	 request, and the host decides what to do with it. *)
		
	) (
		public performText: request <String> via: op <[:[:String | Object] :[:String | Object] | Object]> ^<Promise> = (
			(* op is handed an ok block and a fail block, exactly one of which it
		   should eventually call - ok with the reply text, fail with a legible
		   reason. A raise while starting it breaks the promise rather than
		   escaping to the caller. *)
			
			| r |
			r:: Resolver new.
			[
				op value: [:text | fulfillQuietly: r with: text ]
					value: [:reason | breakQuietly: r with: reason ]
			] on: Exception do: [:e | breakQuietly: r with: (describeJS: e) ].
			^r promise
		)
		public performText: request <String> via: op <[:[:String | Object] :[:String | Object] | Object]> canPerformHere: able <Boolean> ^<Promise> = (
			(* As performText:via:, for a caller that already knows whether the
		   exchange can be carried out from THIS machine.

		   The agent bus needs the distinction: an agent is a process listening on
		   one participant's front door, so in a synchronized session only some
		   participants can reach it. A client that cannot must not be the one
		   elected to perform the exchange - it would perform it into a bus the
		   agent is not on - but it still needs the reply, so it waits for a
		   participant that can. Here there is no other participant, so a caller
		   that cannot perform the exchange is told so instead of waiting. *)
			
			| r |
			able ifTrue: [ ^performText: request via: op ].
			r:: Resolver new.
			breakQuietly: r
				with: 'This exchange cannot be carried out from here, and this session has no other participant that could carry it out.'.
			^r promise
		)
		public shareText: request <String> via: op <[:[:String | Object] :[:String | Object] | Object]> ^<Promise> = (
			(* As performText:via:, for a computation whose EFFECTS must happen on
		   every participant but whose RESULT the session must agree on.

		   An AI tool call is the case in hand. Applying a changeset or evaluating
		   an expression has to change every participant's image, so every client
		   runs it; but the text that goes back to the model, and so into the shared
		   conversation, has to be one text - and a tool may legitimately read
		   things the replicated image does not carry (the clock, the browser, the
		   network, the synchronization machinery itself), so two clients' texts
		   are not guaranteed to agree. Here there is one participant: run op and
		   answer its text. On the Croquet host every client runs op, and the text
		   the elected client produced is recorded and answered to all. *)
			
			^performText: request via: op
		)
	) : ()
	lazy private global = js global.
	lazy public fetcher = Fetcher new.
	lazy public performer = Performer new.
	public busAvailable ^<Boolean> = (
		^boolFor: 'bus'
	)
	public croquetFiles ^<String | UndefinedObject> = (
		(* The origin-relative Croquet file-server path, or nil when this origin announces no local Croquet. *)
		
		^croquetField: 'files'
	)
	public croquetReflector ^<String | UndefinedObject> = (
		(* The local Croquet reflector URL, or nil when this origin announces none. *)
		
		^croquetField: 'reflector'
	)
	public fetchAvailable ^<Boolean> = (
		^boolFor: 'fetch'
	)
	public gitAvailable ^<Boolean> = (
		^boolFor: 'git'
	)
	public serviceOrigin ^<String | UndefinedObject> = (
		(* Where this host's /_ns services live once discovery has settled: '' for
   the page origin (the contract), a base URL for the dev fallback, nil while
   unsettled or when no host answered. Consumers build /_ns URLs by
   concatenation: serviceOrigin , '/_ns/fetch'. *)
		
		ensureProbe.
		configAlien isNil ifTrue: [ ^nil ].
		^serviceBase
	)
	public whenReady: onKnown <[:Host | Object]> = (
		(* Runs onKnown with this host once discovery has settled - immediately if it already has. Registering triggers the probe. Before settlement the synchronous accessors answer unavailable; afterwards they answer the discovered truth. *)
		
		configKnown ifTrue: [
				onKnown value: self.
				^self
			].
		readyBlocks add: onKnown.
		ensureProbe
	)
	acceptConfig: cfg <Alien> base: base <String> ifUnusable: failBlock <[]> = (
		(versionOf: cfg) = 1 ifFalse: [ ^failBlock value ].
		configAlien:: cfg.
		serviceBase:: base.
		finishProbe
	)
	acceptResponse: response <Alien> from: base <String> ifUnusable: failBlock <[]> = (
		| status |
		status:: [ response at: 'status' ] on: Exception do: [:e | nil ].
		(isSuccessStatus: status) ifFalse: [ ^failBlock value ].
		response json then: [:cfg |
				[ acceptConfig: cfg base: base ifUnusable: failBlock ] on: Exception
					do: [:e | failBlock value ].
				nil
			]
			onError: [:e |
				[ failBlock value ] on: Exception do: [:e2 | nil ].
				nil
			]
	)
	boolFor: key <String> ^<Boolean> = (
		(* Synchronous, fail-closed: false until discovery has settled, and false for anything the config does not affirmatively announce. *)
		
		ensureProbe.
		configAlien isNil ifTrue: [ ^false ].
		^[ (configAlien includesKey: key) and: [ (configAlien at: key) = true ] ] on: Exception
			do: [:e | false ]
	)
	breakQuietly: r <Resolver> with: reason <String> = (
		[ r break: reason ] on: Exception do: [:e | nil ]
	)
	croquetField: key <String> ^<String | UndefinedObject> = (
		ensureProbe.
		configAlien isNil ifTrue: [ ^nil ].
		^[
			(configAlien includesKey: 'croquet') ifTrue: [
					| croquet |
					croquet:: configAlien at: 'croquet'.
					(croquet includesKey: key) ifTrue: [ croquet at: key ] ifFalse: [ nil ]
				]
				ifFalse: [ nil ]
		] on: Exception do: [:e | nil ]
	)
	describeJS: reason ^<String> = (
		(* A rejection may be a Newspeak string we produced or a JS error alien; normalise either to something printable without raising. *)
		
		^[ reason , '' ] on: Exception
			do: [:e |
				[ reason printString ] on: Exception do: [:e2 | '(indescribable failure)' ]
			]
	)
	devFallbackBase ^<String | UndefinedObject> = (
		(* Where to look for /_ns/config when the page origin itself has no front
   door - now rare, since staging step 3 folded static serving into the front
   door, so the page origin usually IS the front door and the primary probe
   succeeds. Kept for the case of a page served by a separate static server in
   dev. Per-user override via localStorage ns_host_origin ('off' to disable),
   so nothing is baked in.

   The BUILT-IN default is offered only to a page that is itself on loopback.
   The case it exists for is a dev page served beside the front door, and such
   a page is on localhost; a page that is not would be reaching for a front
   door on whatever machine happens to be running the BROWSER. For a deployed
   site that is someone else's machine: a visitor to a Pages site would have
   their own localhost:8080 probed, and if they happened to be running a front
   door, a page they did not write could learn that, and use /_ns/git (which
   is deliberately not token-gated) as an open proxy. Private Network Access
   ought to block the request before any of that, but relying on the browser
   to refuse what we should not have asked for is the wrong way round.

   An EXPLICIT ns_host_origin is still honoured wherever it is set: that is a
   deliberate act by whoever set it, and the point here is to stop offering a
   default nobody asked for. *)
		
		| raw |
		raw:: [ js localStorage getItem: 'ns_host_origin' ] on: Exception
			do: [:e | nil ].
		raw = 'off' ifTrue: [ ^nil ].
		(raw isNil or: [ raw isKindOfString and: [ raw isEmpty ] ]) ifTrue: [
				pageOriginIsLoopback ifFalse: [ ^nil ].
				^'http://localhost:8080'
			].
		^raw
	)
	pageOriginIsLoopback ^<Boolean> = (
		(* Is the page this image was served to itself on loopback? Answers false
   when the hostname cannot be read, so an unreadable location fails closed
   like everything else in this module. *)
		
		| hostname |
		hostname:: [ (global at: 'location') at: 'hostname' ] on: Exception
			do: [:e | nil ].
		hostname isNil ifTrue: [ ^false ].
		^((hostname = 'localhost' or: [ hostname = '127.0.0.1' ]) or: [
				hostname = '::1'
			]) or: [ hostname = '[::1]' ]
	)
	ensureProbe = (
		(* Fetch /_ns/config once, on first use: the page origin first (the contract), the dev front door second. Every failure path converges on finishProbe with configAlien still nil - fail closed, never an error. *)
		
		configKnown ifTrue: [ ^self ].
		probeInFlight ifTrue: [ ^self ].
		probeInFlight:: true.
		probeAt: ''
			onFailure: [
				| fb |
				fb:: devFallbackBase.
				fb isNil ifTrue: [ finishProbe ]
					ifFalse: [ probeAt: fb onFailure: [ finishProbe ] ]
			]
	)
	finishProbe = (
		configKnown:: true.
		probeInFlight:: false.
		readyBlocks do: [:b | [ b value: self ] on: Exception do: [:e | nil ] ]
	)
	fulfillQuietly: r <Resolver> with: value = (
		[ r fulfill: value ] on: Exception do: [:e | nil ]
	)
	isSuccessStatus: status ^<Boolean> = (
		status isNil ifTrue: [ ^false ].
		^status >= 200 and: [ status < 400 ]
	)
	probeAt: base <String> onFailure: failBlock <[]> = (
		| jsPromise |
		jsPromise:: [ global fetch: base , '/_ns/config' ] on: Exception
			do: [:e | nil ].
		jsPromise isNil ifTrue: [ ^failBlock value ].
		jsPromise then: [:response |
				[ acceptResponse: response from: base ifUnusable: failBlock ] on: Exception
					do: [:e | failBlock value ].
				nil
			]
			onError: [:e |
				[ failBlock value ] on: Exception do: [:e2 | nil ].
				nil
			]
	)
	settleFetch: r <Resolver> from: response <Alien> url: url <String> bytes: wantBytes <Boolean> = (
		(* Settle r from a completed response, reading the body as an ArrayBuffer
	   when wantBytes and as text otherwise. Both readers are JS promises and
	   both failure shapes are identical, so the status check and the error
	   wording are shared rather than copied. *)
		
		| status body |
		status:: [ response at: 'status' ] on: Exception do: [:e | nil ].
		(isSuccessStatus: status) ifFalse: [
				^breakQuietly: r with: 'HTTP ' , (statusLabel: status) , ' fetching ' , url
			].
		body:: wantBytes ifTrue: [ response arrayBuffer ] ifFalse: [ response text ].
		body then: [:b |
				fulfillQuietly: r with: b.
				nil
			]
			onError: [:e |
				breakQuietly: r
					with: 'HTTP ' , (statusLabel: status) , ' but the body was unreadable for ' , url.
				nil
			]
	)
	settleFetch: r <Resolver> from: response <Alien> url: url <String> = (
		^settleFetch: r from: response url: url bytes: false
	)
	statusLabel: status ^<String> = (
		status isNil ifTrue: [ ^'(no status)' ].
		^status printString
	)
	versionOf: cfg <Alien> = (
		^[
			(cfg includesKey: 'version') ifTrue: [ cfg at: 'version' ] ifFalse: [ nil ]
		] on: Exception do: [:e | nil ]
	)
	fetchOptionsForHeaders: hdrs <Alien[JSObject] | UndefinedObject> ^<Alien[JSObject] | UndefinedObject> = (
		(* A GET options object carrying hdrs, or nil when there are none - in which
	   case the caller does the bare one-argument fetch it always did. Kept
	   separate so the plain and the coordinated host build the request
	   identically. *)
		
		^fetchOptionsForHeaders: hdrs body: nil
	)
	fetchOptionsForHeaders: hdrs <Alien[JSObject] | UndefinedObject> body: body <String | UndefinedObject> ^<Alien[JSObject] | UndefinedObject> = (
		(* As fetchOptionsForHeaders:, and POST when there is a body. Nil for
	   neither, so the caller does the bare one-argument fetch it always did. *)
		
		| options |
		(hdrs isNil and: [ body isNil ]) ifTrue: [ ^nil ].
		options:: (global at: #Object) new.
		options at: 'method' put: (body isNil ifTrue: [ 'GET' ] ifFalse: [ 'POST' ]).
		hdrs isNil ifFalse: [ options at: 'headers' put: hdrs ].
		body isNil ifFalse: [ options at: 'body' put: body ].
		^options
	)
	startFetch: url <String> headers: hdrs <Alien[JSObject] | UndefinedObject> resolver: r <Resolver> = (
		(* As startFetch:resolver:, with request headers. *)
		
		^startFetch: url headers: hdrs bytes: false resolver: r
	)
	startFetch: url <String> headers: hdrs <Alien[JSObject] | UndefinedObject> bytes: wantBytes <Boolean> resolver: r <Resolver> = (
		^startFetch: url headers: hdrs body: nil bytes: wantBytes resolver: r
	)
	startFetch: url <String> headers: hdrs <Alien[JSObject] | UndefinedObject> body: body <String | UndefinedObject> bytes: wantBytes <Boolean> resolver: r <Resolver> = (
		(* The canonical request. Reads the response as bytes when wantBytes and as
	   text otherwise; POSTs when there is a body. Only the settle step differs
	   between the readings; the request itself is built in one place. *)
		
		| jsPromise options |
		options:: fetchOptionsForHeaders: hdrs body: body.
		jsPromise:: [
			options isNil ifTrue: [ global fetch: url ]
				ifFalse: [ global fetch: url with: options ]
		] on: Exception do: [:e | nil ].
		jsPromise isNil ifTrue: [
				^breakQuietly: r with: 'fetch could not start for ' , url
			].
		jsPromise then: [:response |
				[ settleFetch: r from: response url: url bytes: wantBytes ] on: Exception
					do: [:e | breakQuietly: r with: (describeJS: e) ].
				nil
			]
			onError: [:e |
				breakQuietly: r
					with: 'fetch failed for ' , url , ' - ' , (describeJS: e) , '. The browser reports no status, headers or body for this class of failure, so it does NOT establish that the site is down.'.
				nil
			]
	)
	startFetch: url <String> resolver: r <Resolver> = (
		^startFetch: url headers: nil resolver: r
	)
	fetchTextFor: url <String> headers: hdrs <Alien[JSObject] | UndefinedObject> ^<Promise> = (
		| r |
		r:: Resolver new.
		startFetch: url headers: hdrs resolver: r.
		^r promise
	)
	fetchTextFor: url <String> headers: hdrs <Alien[JSObject] | UndefinedObject> body: body <String | UndefinedObject> ^<Promise> = (
		| r |
		r:: Resolver new.
		startFetch: url headers: hdrs body: body bytes: false resolver: r.
		^r promise
	)
	fetchBytesFor: url <String> headers: hdrs <Alien[JSObject] | UndefinedObject> ^<Promise> = (
		| r |
		r:: Resolver new.
		startFetch: url headers: hdrs bytes: true resolver: r.
		^r promise
	)
	fetchBytesFor: url <String> ^<Promise> = (
		^fetchBytesFor: url headers: nil
	)
	fetchTextFor: url <String> ^<Promise> = (
		^fetchTextFor: url headers: nil
	)
) : ()
